<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <application android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:label="@string/app_name"
        android:icon="@drawable/ic_unconnected" android:supportsRtl="true"
        android:theme="@style/Theme.Unconnected">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".ScreeningService" android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter><action android:name="android.telecom.CallScreeningService" /></intent-filter>
        </service>
    </application>
</manifest>
